# Router Ollama timeout ms (int)
PIKO_OLLAMA_ROUTER_TIMEOUT_MS=

# Legate num_ctx (int)
PIKO_LEGATE_NUM_CTX=

# Understand num_ctx (int)
PIKO_UNDERSTAND_NUM_CTX=

# Heavy/worker model tag (string)
PIKO_HEAVY_MODEL=

# Enable agent review (bool)
PIKO_AGENT_REVIEW=

# Agent review mode (string)
PIKO_AGENT_REVIEW_MODE=

# Agent review model (string)
PIKO_AGENT_REVIEW_MODEL=

# Agent review Ollama URL (url)
PIKO_AGENT_REVIEW_OLLAMA_URL=

# Agent plan mode (string)
PIKO_AGENT_PLAN_MODE=

# Work planner model (string)
PIKO_EI_WORK_PLANNER_MODEL=

# Work planner num_ctx (int)
PIKO_EI_WORK_PLANNER_NUM_CTX=

# Mission-fit model (string)
PIKO_EI_MISSION_FIT_MODEL=

# Mission-fit num_ctx (int)
PIKO_EI_MISSION_FIT_NUM_CTX=

# Content review enabled (bool)
PIKO_EI_CONTENT_REVIEW=

# Content review model (string)
PIKO_EI_CONTENT_REVIEW_MODEL=

# seek_files timeout ms (int)
PIKO_EI_SEEK_FILES_TIMEOUT_MS=

# seek_files result limit (int)
PIKO_EI_SEEK_FILES_LIMIT=

# Auto article writer (bool)
PIKO_EI_ARTICLE_AUTO=

# EI engineering queue dir (string)
PIKO_EI_ENG_QUEUE_DIR=

# Skip telegram on EI eval (bool)
PIKO_EI_EVAL_SKIP_TELEGRAM=

# Disable AusMaker watchman (bool)
PIKO_DISABLE_AUSMAKER_WATCHMAN=

