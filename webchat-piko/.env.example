# Auto-generated from lib/config.js — do not hand-edit.
# Regenerate: node scripts/generate-env-example.js
#
# Set PIKO_ENV_STRICT=1 on a tenant only after confirming no false failures.

# HTTP listen port (int)
PORT=3000

# Tenant data root (string)
PIKO_DATA_DIR=

# Tenant identifier (string)
PIKO_TENANT_ID=

# Background job profile (enum)
# allowed: culture | ausmaker | shared
PIKO_BACKGROUND_JOBS_PROFILE=

# Fail/warn on missing/unknown env (bool)
PIKO_ENV_STRICT=0

# Disable cloud LLM fallbacks (bool, required when strict)
PIKO_OLLAMA_ONLY=0

# Serialize Ollama calls (bool)
PIKO_OLLAMA_QUEUE=0

# Chat-lane Ollama base URL (url)
OLLAMA_URL=

# Worker-lane Ollama base URL (url)
PIKO_WORKER_OLLAMA_URL=

# Legate decide Ollama URL (url)
PIKO_LEGATE_OLLAMA_URL=

# Understand Ollama URL (url)
PIKO_UNDERSTAND_OLLAMA_URL=

# Default/persona model (string)
OLLAMA_MODEL=llama3.1:8b

# Decide/opinion model (27B) (string, required when strict)
PIKO_LEGATE_MODEL=

# Understand model (27B) (string, required when strict)
PIKO_UNDERSTAND_MODEL=

# Authoritative understand gateway (bool)
PIKO_UNDERSTAND_AUTHORITATIVE=0

# Expert-opinion lane (default on for culture) (bool)
PIKO_EXPERT_OPINION=

# Legacy primary model tag (string)
MODEL_PRIMARY=

# Shared webhook bearer/key (fallback; prefer PIKO_DATA_DIR/secrets/webhook.json) (string, required when strict)
PIKO_WEBHOOK_SECRET=

# Admin gate password (string)
PIKO_ADMIN_PASSWORD=

# API key for adapters/monitors (fallback; prefer PIKO_DATA_DIR/secrets/api-key.json) (string)
PIKO_API_KEY=

# API auth mode (strict default; set lan explicitly for private-IP trust) (enum)
# allowed: lan | strict | off
PIKO_API_AUTH=strict

# Opt into open non-webchat channels (bool)
PIKO_CHANNEL_ALLOWLIST_OPEN=0

# Enable /task shell surface (bool)
PIKO_TASK_ENDPOINT=0

# Enable Legate chat path (bool)
PIKO_LEGATE_CHAT=1

# Enable agent orchestration (bool)
PIKO_AGENT_ORCH=1

# Enable in-process agent worker (bool)
PIKO_AGENT_WORKER=1

# Chat process: reaper only; claim loop in standalone worker (bool)
PIKO_WORKER_STANDALONE=0

# Standalone worker clears drain file at boot (bool)
PIKO_WORKER_CLEAR_DRAIN_ON_BOOT=1

# Job wall-clock timeout ms (int)
PIKO_AGENT_JOB_TIMEOUT_MS=1200000

# Pending jobs cap per type (int)
PIKO_AGENT_PENDING_CAP=25

# Default max lines for bounded JSONL logs (int)
PIKO_JSONL_MAX_LINES=2000

# Max lines for piko-activity.jsonl (int)
PIKO_ACTIVITY_JSONL_MAX=2000

# Max lines for campaign_cycles.jsonl (int)
PIKO_CAMPAIGN_CYCLES_JSONL_MAX=2000

# Max lines for learning_scorecard.jsonl (int)
PIKO_SCORECARD_JSONL_MAX=500

# Max lines for hq-audit.jsonl (int)
PIKO_HQ_AUDIT_JSONL_MAX=2000

# Allow operators to access any sessionId (logged) (bool)
PIKO_SESSION_OWNER_OVERRIDE=0

# EI corpus data root (string)
EGYPTIAN_INSIGHTS_DATA_DIR=

# Alias for EI data root (string)
PIKO_EGYPTIAN_DATA_DIR=

# Mission-fit review enabled (bool)
PIKO_EI_MISSION_FIT=1

# Quarantine drops after mission-fit (bool)
PIKO_EI_MISSION_FIT_PURGE=1

# Quarantine retention days (int)
PIKO_QUARANTINE_DAYS=14

# Set off to disable corpus RAG (string)
PIKO_EI_CORPUS_RAG=

# Allow one bounded replan (bool)
PIKO_EI_REPLAN=1

# Pino log level (enum)
# allowed: fatal | error | warn | info | debug | trace | silent
PIKO_LOG_LEVEL=info

# Optional pino destination file (string)
PIKO_LOG_PATH=

# Proactive webhook URL (url)
PIKO_PROACTIVE_WEBHOOK_URL=

# WhatsApp proactive webhook (url)
PIKO_PROACTIVE_WEBHOOK_WHATSAPP_URL=

# iMessage proactive webhook (url)
PIKO_PROACTIVE_WEBHOOK_IMESSAGE_URL=

# Admin login username (string)
PIKO_ADMIN_USER=admin

# Health/monitor API key (string)
PIKO_HEALTH_API_KEY=

# YOLO/HITL API key (string)
PIKO_YOLO_API_KEY=

# Public webchat URL (url)
PIKO_WEBCHAT_URL=

# Public base URL (url)
PIKO_PUBLIC_BASE_URL=

# iOS client public URL (url)
PIKO_IOS_PUBLIC_URL=

# Repo root for tools (string)
PIKO_REPO_ROOT=

# Knowledge base path (string)
PIKO_KNOWLEDGE_PATH=

# Site manifest path (string)
PIKO_SITE_MANIFEST=

# Tenant registry path (string)
PIKO_TENANT_REGISTRY=

# Legion adapter API base (url)
