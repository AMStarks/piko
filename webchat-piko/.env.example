# Piko WebChat — copy to .env and set as needed. Do not commit .env.

PORT=3000
# OLLAMA_URL=http://localhost:11434/v1/chat/completions
#
# WP8 — LLM-first comprehension (pin to Legate-class 27B on Rodimus; never 8B)
# PIKO_UNDERSTAND_MODEL=qwen3.6:27b
# PIKO_UNDERSTAND_AUTHORITATIVE=1
# PIKO_UNDERSTAND_SHADOW=1
# PIKO_LEGATE_MODEL=qwen3.6:27b
# OLLAMA_MODEL=llama3.1:latest

# --- Rodimus gateway (Optimus WebChat → LAN 70B appliance) ---
# Copy these onto Optimus /root/webchat-piko/.env when Rodimus is the sole LLM backend (RFC1918 UFW on Rodimus allows LAN :11434).
# OLLAMA_URL=http://192.168.0.180:11434/v1/chat/completions
# OLLAMA_MODEL=llama3:70b-instruct-q4_K_M
# OPENAI_API_KEY=legion-rodimus-unified
# LOG_LEVEL=info
# Or e.g. qwen2.5:14b (fast), gemma2:27b-it-q4_K_M (best chat on 10GB). Use /model <tag> in chat to switch without restart.

# Front desk (8B) vs back office (70B) — see lib/frontDesk.js
# OLLAMA_MODEL=llama3.1:8b
# PIKO_HEAVY_MODEL=llama3:70b-instruct-q4_K_M
# PIKO_HEAVY_SYNTHESIS=1
# PIKO_ASYNC_ACK=1
# PIKO_HEAVY_CODE_GEN=1
# PIKO_HEAVY_SYNTH_TIMEOUT_MS=120000

# 7B/8B model lock for router + casual chat
# PIKO_ROUTER_MODEL=llama3.1:8b
# PIKO_CASUAL_MODEL=llama3.1:8b

# ReAct agent (Phase 2): when task, use think-act-reflect loop instead of single routeToAction
# PIKO_USE_REACT_AGENT=1

# Python sandbox (Quant Agent nightly): default 120s; full-catalog forecasts need more on Optimus
# PIKO_PYTHON_SANDBOX_TIMEOUT_MS=120000
# PIKO_QUANT_PYTHON_TIMEOUT_MS=900000

# AusMaker API (Weekly PO draft + forecast routes). On Optimus, match the port your AusMaker container exposes (see scripts/webchat-deploy/piko-webchat.service.d/70-integrations.conf).
# AUSMAKER_BASE_URL=http://127.0.0.1:5001
# LEGION_ADAPTER_API_BASE=http://127.0.0.1:8000

# Inventory webhook (/webhook/inventory-alert): debounce rapid POSTs into one Telegram (ms). 0 = send each alert immediately (old behaviour).
# PIKO_INVENTORY_ALERT_BATCH_MS=4000

# Data and paths
# PIKO_DATA_DIR=./data
# PIKO_SANDBOX_DIR=./sandbox
# PIKO_HISTORY_DIR=./history

# Memory & planner (optional)
# PIKO_EPISODIC_PRUNE_DAYS=30
# PIKO_PLANNER_DEBUG=0
# PIKO_CONTROLLED_DIVERGENCE=0
# PIKO_DIVERGENCE_PROMPT=

# For intent-poller and scripts calling the API
# PIKO_WEBCHAT_URL=http://localhost:3000
# If you generate `piko_state.json` on a different host (e.g. your Mac) but want to pull telemetry from Optimus WebChat:
# PIKO_WEBCHAT_URL=http://114.73.210.115:3000

# Legion integration (Piko → Legion adapter runs)
# PIKO_LEGION_ADAPTER_API_BASE=http://192.168.0.121:8000
# LEGION_ADAPTER_API_BEARER=   # optional, if Legion requires auth
# PIKO_LEGION_TIMEOUT_MS=20000 # timeout for Legion POST (default 20s; increase if adapter is slow)

# Intent poller robustness (optional)
# PIKO_POLLER_IDEMPOTENCY_MINUTES=5
# PIKO_POLLER_MAX_RETRIES=3

# Logging
# PIKO_LOG_PATH=./data/piko.log
# PIKO_LOG_LEVEL=info
# PIKO_LOG_CONSOLE=0

# Webhook verification (adapters e.g. BlueBubbles; also for POST /api/webhooks/events)
# PIKO_WEBHOOK_SECRET=   # if set, require Bearer or X-Webhook-Key header
# BLUEBUBBLES_WEBHOOK_SECRET=
# BLUEBUBBLES_WEBHOOK_SIGNATURE_HEADER=x-webhook-signature

# Gmail context in chat (requires Gmail OAuth)
# PIKO_EA_GMAIL_READ_BODY=1

# Optional: search, Moltbook, Telegram, Notion, etc.
# SEARXNG_URL=http://127.0.0.1:8080  # local SearXNG (default)
# SERPER_API_KEY=
# MOLTBOOK_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
