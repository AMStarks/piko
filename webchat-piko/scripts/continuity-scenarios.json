      "criteria": { "continuity": 5, "naturalness": 5, "no_bleed": 5, "no_reset": 5, "mode_fit": 5 }
    },
    {
      "id": "02_reciprocity_chain",
      "name": "Reciprocity chain (3 turns)",
      "tags": ["continuity", "reciprocity"],
      "expected_mode": "RECIPROCITY",
      "turns": [
        "Not bad, how about you?",
        "Pretty good — yourself?",
        "Going well thanks. You?"
      ],
      "criteria": { "continuity": 5, "naturalness": 5, "no_bleed": 5, "no_reset": 5, "mode_fit": 5 }
    },
    {
