      "turns": ["Thanks, that's all for now.", "Catch you later.", "Talk soon.", "Cheers mate."],
      "criteria": { "continuity": 5, "naturalness": 5, "no_bleed": 5, "no_reset": 5, "mode_fit": 5 }
