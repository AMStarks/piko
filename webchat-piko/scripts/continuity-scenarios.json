  "scoring_schema": {
    "criteria": [
      { "name": "continuity", "weight": 1.0, "desc": "Reply clearly connects to previous turn" },
      { "name": "naturalness", "weight": 1.0, "desc": "No robotic stock phrasing" },
      { "name": "no_bleed", "weight": 1.0, "desc": "No worldview/theology motifs unless invited" },
      { "name": "no_reset", "weight": 1.0, "desc": "Does not restart conversation" },
      { "name": "mode_fit", "weight": 0.8, "desc": "Tone matches mode (greeting/reciprocity etc.)" }
    ],
    "scenario_pass_threshold": 4.0,
    "overall_pass_threshold": 0.8
  }
