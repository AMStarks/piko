      "tags": ["continuity", "empathy"],
      "expected_mode": "SOCIAL_EMPATHY",
      "turns": [
        "I had a rough day today.",
        "Feeling a bit flat.",
        "Feels like I'm not making progress lately."
      ],
      "criteria": { "continuity": 5, "naturalness": 5, "no_bleed": 5, "no_reset": 5, "mode_fit": 5 }
    },
    {
