{
  "version": "1.1",
  "description": "12 multi-turn continuity scenarios for conversational naturalness.",
  "scenarios": [
    {
      "id": "01_greeting_to_invite",
      "name": "Greeting → reciprocity → invitation to chat",
      "tags": ["continuity", "social_chat"],
      "expected_mode": "SOCIAL_CHAT",
      "turns": [
        "Hey Piko",
        "How are things?",
        "Good, good. I'm just doing some work. Want to chat for a while?"
