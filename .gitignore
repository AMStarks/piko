# Secrets and env (never commit tokens)
.env
.env.*
!.env.example
*.key
sites/*/env.template
sites/*/secrets-seed/

# Dependencies
node_modules/
.venv-os/

# KAIROS local dedupe state (optional)
data/kairos-last-notify.json
data/hitl_pending/*.json
data/egyptian-insights/cultures_cache.sqlite
data/egyptian-insights/assets/images/*
!data/egyptian-insights/assets/images/.gitkeep
!data/egyptian-insights/.gitkeep

# Local data
history/
memory/
logs/

# Export artifacts
PIKO_CODEBASE_EXPORT*.txt
PIKO_CODEBASE_EXPORT*.tar.gz
PIKO_CODEBASE_EXPORT*.zip
CODEBASE_FULL.pdf
CODEBASE_FULL.txt
CONVERSATION_CODE.txt
PIKO_FULL_CODE_EXPORT.txt

