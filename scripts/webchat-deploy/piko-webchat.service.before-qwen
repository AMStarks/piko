# SAVED STATE BEFORE QWEN — do not edit. Use for rollback only.
# Restore: sudo cp /root/projects/Piko/scripts/webchat-deploy/piko-webchat.service.before-qwen /etc/systemd/system/piko-webchat.service && sudo systemctl daemon-reload && sudo systemctl restart piko-webchat.service
# Or run: scripts/webchat-deploy/rollback-to-llama.sh (from repo root, with SSH to Optimus)

[Unit]
Description=Piko WebChat (Llama 3.1 8B via Ollama)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/webchat-piko
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
Environment=PORT=3000
Environment=OLLAMA_URL=http://localhost:11434/v1/chat/completions
Environment=OLLAMA_MODEL=llama3.1:latest
Environment=PIKO_OLLAMA_ONLY=1
# Unified session: one bot for WebChat + Telegram (and any other channel hitting /api/chat).
Environment=PIKO_UNIFIED_SESSION_ID=main
# Optional: Grok (xAI) second opinion when Piko isn't satisfied with Cursor result. Set on Optimus, never commit.
# Environment=GROK_API_KEY=

[Install]
WantedBy=multi-user.target
